َ نَبَّأَنِيَ ٱلۡعَلِيمُ ٱلۡخَبِيرُ","translation_bn":"যখন নবী তাঁর একজন স্ত্রীর কাছে একটি কথা গোপনে বললেন, অতঃপর স্ত্রী যখন তা বলে দিল এবং আল্লাহ নবীকে তা জানিয়ে দিলেন, তখন নবী সে বিষয়ে স্ত্রীকে কিছু বললেন এবং কিছু বললেন না। নবী যখন তা স্ত্রীকে বললেন, তখন স্ত্রী বললেনঃ কে আপনাকে এ সম্পর্কে অবহিত করল? নবী বললেন,ঃ যিনি সর্বজ্ঞ, ওয়াকিফহাল, তিনি আমাকে অবহিত করেছেন।","audio_ayah":"","words":[{"key":"66:3:1","position":1,"arabic":"وَإِذۡ","meaning_bn":"এবং যখন","root":null,"is_verb":false,"audio_word":""},{"key":"66:3:2","position":2,"arabic":"أَسَرَّ","meaning_bn":"গোপনে বলেছিল","root":"سرر","is_verb":true,"audio_word":""},{"key":"66:3:3","position":3,"arabic":"ٱلنَّبِيُّ","meaning_bn":"নবী","root":"نبا","is_verb":true,"audio_word":""},{"key":"66:3:4","position":4,"arabic":"إِلَىٰ","meaning_bn":"নিকট","root":null,"is_verb":false,"audio_word":""},{"key":"66:3:5","position":5,"arabic":"بَعۡضِ","meaning_bn":"কারও","root":"بعض","is_verb":false,"audio_word":""},{"key":"66:3:6","position":6,"arabic":"أَزۡوَٰجِهِۦ","meaning_bn":"তার স্ত্রীদের","root":"زوج","is_verb":true,"audio_word":""},{"key":"66:3:7","position":7,"arabic":"حَدِيثٗا","meaning_bn":"একটি কথা","root":"حدث","is_verb":true,"audio_word":""},{"key":"66:3:8","position":8,"arabic":"فَلَمَّا","meaning_bn":"যখন অতঃপর","root":null,"is_verb":false,"audio_word":""},{"key":"66:3:9","position":9,"arabic":"نَبَّأَتۡ","meaning_bn":"সে বলে দেয় (অন্য স্ত্রীকে)","root":"نبا","is_verb":true,"audio_word":""},{"key":"66:3:10","position":10,"arabic":"بِهِۦ","meaning_bn":"তা সম্পর্কে","root":null,"is_verb":false,"audio_word":""},{"key":"66:3:11","position":11,"arabic":"وَأَظۡهَرَهُ","meaning_bn":"ও তা প্রকাশ করলেন","root":"ظهر","is_verb":true,"audio_word":""},{"key":"66:3:12","position":12,"arabic":"ٱللَّهُ","meaning_bn":"আল্লাহ","root":"اله","is_verb":true,"audio_word":""},{"key":"66:3:13","position":13,"arabic":"عَلَيۡهِ","meaning_bn":"তার নিকট","root":null,"is_verb":false,"audio_word":""},{"key":"66:3:14","position":14,"arabic":"