আনের যতটুকু তোমাদের জন্যে সহজ ততটুকু আবৃত্তি কর। তোমরা নামায কায়েম কর, যাকাত দাও এবং আল্লাহকে উত্তম ঋণ দাও। তোমরা নিজেদের জন্যে যা কিছু অগ্রে পাঠাবে, তা আল্লাহর কাছে উত্তম আকারে এবং পুরস্কার হিসেবে বর্ধিতরূপে পাবে। তোমরা আল্লাহর কাছে ক্ষমাপ্রার্থনা কর। নিশ্চয় আল্লাহ ক্ষমাশীল, দয়ালু।","audio_ayah":"","words":[{"key":"73:20:1","position":1,"arabic":"۞إِنَّ","meaning_bn":"নিশ্চয়","root":null,"is_verb":false,"audio_word":""},{"key":"73:20:2","position":2,"arabic":"رَبَّكَ","meaning_bn":"তোমার রব","root":"ربب","is_verb":false,"audio_word":""},{"key":"73:20:3","position":3,"arabic":"يَعۡلَمُ","meaning_bn":"জানেন","root":"علم","is_verb":true,"audio_word":""},{"key":"73:20:4","position":4,"arabic":"أَنَّكَ","meaning_bn":"তুমি যে","root":null,"is_verb":false,"audio_word":""},{"key":"73:20:5","position":5,"arabic":"تَقُومُ","meaning_bn":"(ইবাদতে) দাঁড়াও","root":"قوم","is_verb":true,"audio_word":""},{"key":"73:20:6","position":6,"arabic":"أَدۡنَىٰ","meaning_bn":"প্রায়","root":"دنو","is_verb":true,"audio_word":""},{"key":"73:20:7","position":7,"arabic":"مِن","meaning_bn":"মধ্য হতে","root":null,"is_verb":false,"audio_word":""},{"key":"73:20:8","position":8,"arabic":"ثُلُثَيِ","meaning_bn":"দুই তৃিতীয়াংশ","root":"ثلث","is_verb":false,"audio_word":""},{"key":"73:20:9","position":9,"arabic":"ٱلَّيۡلِ","meaning_bn":"রাতের","root":"ليل","is_verb":false,"audio_word":""},{"key":"73:20:10","position":10,"arabic":"وَنِصۡفَهُۥ","meaning_bn":"এবং তার অর্ধেক","root":"نصف","is_verb":false,"audio_word":""},{"key":"73:20:11","position":11,"arabic":"وَثُلُثَهُۥ","meaning_bn":"এবং এক তৃিতীয়াংশ","root":"ثلث","is_verb":false,"audio_word":""},{"key":"73:20:12","position":12,"arabic":"وَطَآئِفَةٞ","meaning_bn":"এবং একদল","root":"طوف","is_verb":true,"audio_word":""},{"key":"73:20:13","position":13,"arabic":"مِّنَ","meaning_bn":"থেকে","root":null,"is_verb":false,"audio_word":""},{"key":"73:20:14","position":14,"arabic":"ٱلَّذِينَ","meaning_bn":"যারা (তাদের)","root":null,"is_verb":false,"audio_wor