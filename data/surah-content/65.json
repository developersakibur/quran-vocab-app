{"surah":65,"total_ayahs":12,"ayahs":[{"surah":65,"ayah":1,"verse_key":"65:1","arabic":"يَٰٓأَيُّهَا ٱلنَّبِيُّ إِذَا طَلَّقۡتُمُ ٱلنِّسَآءَ فَطَلِّقُوهُنَّ لِعِدَّتِهِنَّ وَأَحۡصُواْ ٱلۡعِدَّةَۖ وَٱتَّقُواْ ٱللَّهَ رَبَّكُمۡۖ لَا تُخۡرِجُوهُنَّ مِنۢ بُيُوتِهِنَّ وَلَا يَخۡرُجۡنَ إِلَّآ أَن يَأۡتِينَ بِفَٰحِشَةٖ مُّبَيِّنَةٖۚ وَتِلۡكَ حُدُودُ ٱللَّهِۚ وَمَن يَتَعَدَّ حُدُودَ ٱللَّهِ فَقَدۡ ظَلَمَ نَفۡسَهُۥۚ لَا تَدۡرِي لَعَلَّ ٱللَّهَ يُحۡدِثُ بَعۡدَ ذَٰلِكَ أَمۡرٗا","translation_bn":"হে নবী, তোমরা যখন স্ত্রীদেরকে তালাক দিতে চাও, তখন তাদেরকে তালাক দিয়ো ইদ্দতের প্রতি লক্ষ্য রেখে এবং ইদ্দত গণনা করো। তোমরা তোমাদের পালনকর্তা আল্লাহকে ভয় করো। তাদেরকে তাদের গৃহ থেকে বহিস্কার করো না এবং তারাও যেন বের না হয় যদি না তারা কোন সুস্পষ্ট নির্লজ্জ কাজে লিপ্ত হয়। এগুলো আল্লাহর নির্ধারিত সীমা। যে ব্যক্তি আল্লাহর সীমালংঘন করে, সে নিজেরই অনিষ্ট করে। সে জানে না, হয়তো আল্লাহ এই তালাকের পর কোন নতুন উপায় করে দেবেন।","audio_ayah":"","words":[{"key":"65:1:1","position":1,"arabic":"يَٰٓأَيُّهَا","meaning_bn":"হে","root":"ايي","is_verb":false,"audio_word":""},{"key":"65:1:2","position":2,"arabic":"ٱلنَّبِيُّ","meaning_bn":"নবী","root":"نبا","is_verb":true,"audio_word":""},{"key":"65:1:3","position":3,"arabic":"إِذَا","meaning_bn":"যখন","root":null,"is_verb":false,"audio_word":""},{"key":"65:1:4","position":4,"arabic":"طَلَّقۡتُمُ","meaning_bn":"তোমরা তালাক দাও","root":"طلق","is_verb":true,"audio_word":""},{"key":"65:1:5","position":5,"arabic":"ٱلنِّسَآءَ","meaning_bn":"স্ত্রীদের","root":"نسو","is_verb":false,"audio_word":""},{"key":"65:1:6","position":6,"arabic":"فَطَلِّقُوهُنَّ","meaning_bn":"অতঃপর তাদের তোমরা তালাক দাও","root":"طلق","is_verb":true,"audio_word":""},{"key":"65:1:7","position":7,"arabic":"لِعِدَّتِهِنَّ","meaning_bn":"তাদের ইদ্দতের জন্য","root":"عدد","is_verb":true,"audio_word":""},{"key":"65:1:8","position":8,"arabic":"وَأَحۡصُواْ","meaning_bn":"ও তোমরা গণনা কর","root":"حصي","is_verb":true,"audio_word":""},{"key":"65:1:9","position":9,"arabic":"ٱلۡعِدَّةَۖ","mea