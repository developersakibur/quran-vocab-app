هُنَّ بِمَعۡرُوفٍ أَوۡ فَارِقُوهُنَّ بِمَعۡرُوفٖ وَأَشۡهِدُواْ ذَوَيۡ عَدۡلٖ مِّنكُمۡ وَأَقِيمُواْ ٱلشَّهَٰدَةَ لِلَّهِۚ ذَٰلِكُمۡ يُوعَظُ بِهِۦ مَن كَانَ يُؤۡمِنُ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِۚ وَمَن يَتَّقِ ٱللَّهَ يَجۡعَل لَّهُۥ مَخۡرَجٗا","translation_bn":"অতঃপর তারা যখন তাদের ইদ্দতকালে পৌঁছে, তখন তাদেরকে যথোপযুক্ত পন্থায় রেখে দেবে অথবা যথোপযুক্ত পন্থায় ছেড়ে দেবে এবং তোমাদের মধ্য থেকে দু’জন নির্ভরযোগ্য লোককে সাক্ষী রাখবে। তোমরা আল্লাহর উদ্দেশ্যে সাক্ষ্য দিবে। এতদ্দ্বারা যে ব্যক্তি আল্লাহ ও পরকালে বিশ্বাস করে, তাকে উপদেশ দেয়া হচ্ছে। আর যে আল্লাহকে ভয় করে, আল্লাহ তার জন্যে নিস্কৃতির পথ করে দেবেন।","audio_ayah":"","words":[{"key":"65:2:1","position":1,"arabic":"فَإِذَا","meaning_bn":"যখন অতঃপর","root":null,"is_verb":false,"audio_word":""},{"key":"65:2:2","position":2,"arabic":"بَلَغۡنَ","meaning_bn":"তারা পৌঁছে","root":"بلغ","is_verb":true,"audio_word":""},{"key":"65:2:3","position":3,"arabic":"أَجَلَهُنَّ","meaning_bn":"তাদের সময়কালে","root":"اجل","is_verb":true,"audio_word":""},{"key":"65:2:4","position":4,"arabic":"فَأَمۡسِكُوهُنَّ","meaning_bn":"তাদের রাখতে তখন তোমরা","root":"مسك","is_verb":true,"audio_word":""},{"key":"65:2:5","position":5,"arabic":"بِمَعۡرُوفٍ","meaning_bn":"যথাবিধি","root":"عرف","is_verb":true,"audio_word":""},{"key":"65:2:6","position":6,"arabic":"أَوۡ","meaning_bn":"বা","root":null,"is_verb":false,"audio_word":""},{"key":"65:2:7","position":7,"arabic":"فَارِقُوهُنَّ","meaning_bn":"তাদের তোমরা পৃথক করবে","root":"فرق","is_verb":true,"audio_word":""},{"key":"65:2:8","position":8,"arabic":"بِمَعۡرُوفٖ","meaning_bn":"যথাবিধি","root":"عرف","is_verb":true,"audio_word":""},{"key":"65:2:9","position":9,"arabic":"وَأَشۡهِدُواْ","meaning_bn":"ও তোমরা সাক্ষী রাখ","root":"شهد","is_verb":true,"audio_word":""},{"key":"65:2:10","position":10,"arabic":"ذَوَيۡ","meaning_bn":"আছে","root":null,"is_verb":false,"audio_word":""},{"key":"65:2:11","position":11,"arabic":"عَدۡلٖ","meaning_bn":"ন্যায়পরায়ণ দু'জন","root":"عدل","is_verb":true,"audio_word":""},{